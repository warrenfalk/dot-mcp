{
  "name": "dot-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "start": "node dist/src/index.js",
    "doctor": "node dist/src/doctor.js",
    "test": "pnpm build && node --test dist/test/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "7.0.2"
  }
}
